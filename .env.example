# GOOGLE_PLACES_API_KEY: Chiave API per Google Places (New) Text Search
# Necessaria per la ricerca automatica e l'estrazione lead da Google Maps.
# Ottenibile da Google Cloud Console -> APIs & Services -> Credentials
# Abilitare nel progetto GCP: "Places API (New)"
# Su Vercel: inserire in Project Settings -> Environment Variables
GOOGLE_PLACES_API_KEY="la_tua_google_places_api_key"

# GEMINI_API_KEY: Opzionale per il generatore AI di script di vendita e pitch personalizzati.
GEMINI_API_KEY="la_tua_gemini_api_key"

# APP_URL: URL pubblico dell'applicazione
APP_URL="https://tuo-progetto.vercel.app"
